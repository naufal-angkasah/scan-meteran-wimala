rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Peran dibaca dari dokumen users/{uid} (akun dibuat tanpa custom claims)
    function isAuthenticated() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && roleOf(request.auth.uid) == 'admin';
    }

    function isWorker() {
      return isAuthenticated() && roleOf(request.auth.uid) == 'worker';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. users: admin baca/tulis semua, user baca datanya sendiri
    match /users/{userId} {
      allow read: if isAuthenticated() && (isAdmin() || isOwner(userId));
      allow write: if isAdmin();
    }

    // 2. customers: admin CRUD penuh.
    // Worker boleh membaca dan MEMBUAT unit baru hanya jika ditandai needsReview
    // (unit dari stiker yang belum ada di database, nanti disesuaikan admin).
    match /customers/{customerId} {
      allow read: if isAdmin() || isWorker();
      allow create: if isAdmin() || (
        isWorker() &&
        request.resource.data.needsReview == true &&
        request.resource.data.sumber == 'worker'
      );
      allow update, delete: if isAdmin();
    }

    // 3. tariffs: admin tulis, admin & worker baca
    match /tariffs/{tariffId} {
      allow read: if isAdmin() || isWorker();
      allow write: if isAdmin();
    }

    // 4. readings: worker mencatat langsung (tanpa Cloud Function), hanya atas namanya sendiri.
    match /readings/{readingId} {
      allow read: if isAdmin() || isWorker();
      allow create: if isAdmin() || (
        isWorker() && request.resource.data.dicatatOlehUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isWorker() &&
        resource.data.dicatatOlehUid == request.auth.uid &&
        request.resource.data.dicatatOlehUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }
  }
}
